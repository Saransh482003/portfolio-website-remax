# Required for the streaming portfolio assistant (Server-side only — never exposed to browser)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Any OpenRouter streaming-compatible model (e.g., openai/gpt-4o-mini, google/gemini-2.5-flash, anthropic/claude-3.5-haiku)
OPENROUTER_MODEL=google/gemini-2.5-flash

# Canonical domain for SEO, sitemap.xml, robots.txt, and JSON-LD schema
NEXT_PUBLIC_SITE_URL=https://www.saranshsaini.in

# Your personal Calendly scheduling URL (rendered on /consulting as both direct link & inline embed)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-calendly-handle/30min

# Optional: Google Search Console meta verification code
GOOGLE_SITE_VERIFICATION=
